# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
DATABASE_URL=postgres://postgres:postgres@localhost:5432/character_poc

# Inferaft OpenAI-compatible endpoint
INFERAFT_API_URL=https://inferaft.com/v1
INFERAFT_API_KEY=
INFERAFT_CHAT_MODEL=qwen-3.8-27b
# Set true only for local UI testing when you do not want to spend inference.
INFERAFT_MOCK=false

# Long-term semantic/temporal memory (recommended)
ZEP_API_KEY=

# Memory policy
SUMMARY_EVERY_TURNS=8
RECENT_MESSAGE_LIMIT=14
