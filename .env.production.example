# Copy to ~/apps/inferaft-character/.env.production on dev1 (chmod 600).
# DATABASE_URL is composed by compose.app.yaml from DB_PASSWORD, so only the
# password lives here — the same split the Inferaft core uses.

# openssl rand -base64 32
DB_PASSWORD=
BETTER_AUTH_SECRET=

BETTER_AUTH_URL=https://story.inferaft.com

INFERAFT_API_URL=https://inferaft.com/v1
INFERAFT_API_KEY=
# qwen-3.8-27b reasons before it speaks (slow first token); deepseek-v4-flash is ~15x faster.
INFERAFT_CHAT_MODEL=deepseek-v4-flash
INFERAFT_MOCK=false

# Optional: temporal/semantic memory. Empty keeps the app on PostgreSQL summaries only.
ZEP_API_KEY=

SUMMARY_EVERY_TURNS=8
RECENT_MESSAGE_LIMIT=14
